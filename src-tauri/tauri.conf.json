{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Litrev",
  "version": "0.1.0",
  "identifier": "dev.litrev.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Litrev",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
